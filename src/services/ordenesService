import { supabase } from '../lib/supabaseClient'

export async function guardarOrdenCompleta(vehiculoSeleccionado, datosIngreso, datosConceptos, fotos) {
  // Obtener usuario autenticado para el registro de la orden
  const { data: authData } = await supabase.auth.getUser ()
  const usuarioActual = 
    datosIngreso?.usuarioRegistro ||
    authData?.user?.email ||
    authData?.user?.id
  
  if (!usuarioActual) {
    throw new Error('No se detectó un usuario autenticado para registrar la orden.')
  }

  // Paso A: Insertar Cabecera de la Orden
  const { data: ordenGuardada, error: errOrden } = await supabase
    .from('ordenes_servicio')
    .insert([{
      vin_serie: vehiculoSeleccionado.vin_serie,
      id_cliente: vehiculoSeleccionado.id_cliente ?? null,
      kilometraje_ingreso: Number (datosIngreso.kilometraje) || 0,
      estatus_orden: datosIngreso.estatusOrden || 'Pendiente',
      usuario_registro: usuarioActual
    }])
    .select()
    .single()
    
  if (errOrden) throw errOrden

  const idOrdenGenerado = ordenGuardada.id_orden

  // Paso B: Insertar el Desglose de Conceptos (Servicios / Refacciones)
  if (datosConceptos?.conceptos?.length > 0) {
  const conceptosAInsertar = datosConceptos.conceptos.map((c) => {
    const cantidad = Math.max(1, Number(c.cantidad) || 1)
    const precioUnitario = Math.max(0, Number(c.precio ?? c.precio_cobrado) || 0)
    const descripcion = c.descripcion ?? c.descripcion_item ?? ''

    return {
      id_orden: idOrdenGenerado,
      descripcion_item: descripcion,
      cantidad,
      precio_cobrado: precioUnitario,
      subtotal: cantidad * precioUnitario
    }
    
  })

  const { error: errConceptos } = await supabase
    .from('detalle_orden_precios')
    .insert(conceptosAInsertar)

  if (errConceptos) throw errConceptos

  }

  // Paso C: Subir Fotos a Storage y registrar en evidencias_orden
  if (fotos?.length > 0) {
    for (const foto of fotos) {
      const fileExt = foto.file.name.split('.').pop()
      const fileName = `${idOrdenGenerado}/${foto.etiqueta}_${Date.now()}.${fileExt}`

      const { error: errStorage } = await supabase
        .storage
        .from('evidencias')
        .upload(fileName, foto.file)

      if (errStorage) {
        console.error(`Error al subir imagen ${foto.etiqueta}:`, errStorage.message)
        continue
      }

      const { data: urlData } = supabase.storage
        .from('evidencias')
        .getPublicUrl(fileName)

      const { error: errEvidencia } = await supabase
        .from('evidencias_orden')
        .insert([{
          id_orden: idOrdenGenerado,
          url_foto: urlData.publicUrl,
          etiqueta: foto.etiqueta || 'Recepción'
        }])
      
      if (errEvidencia) {
        console.error('Error al registrar evidencia en BD:', errEvidencia.message)
      }      
    }
  }

  return idOrdenGenerado
}